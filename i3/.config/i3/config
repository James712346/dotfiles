## i3 Config File - Personal Setup
## Cleaned and organised version with Everforest colour scheme

#################################
#           STARTUP             #
#################################

# Graphics setup
exec xrandr --setprovideroutputsource modesetting NVIDIA-0
exec xrandr --auto

# Set wallpaper
exec --no-startup-id sleep 2 && nitrogen --restore

# Auto-arrange displays
exec_always --no-startup-id /usr/bin/autorandr -c &

# Launch Polybar
exec_always --no-startup-id ~/.config/polybar/launch.sh &

# Start Pika Backup Daemon
exec_always --no-startup-id /usr/bin/flatpak run --command=/app/bin/pika-backup-monitor org.gnome.World.PikaBackup &

# Start Vicinae (Launcher)
exec_always --no-startup-id /usr/bin/vicinae server &

#################################
#        BASIC SETTINGS         #
#################################

# Set modifier key (Super/Windows key)
set $mod Mod4

# Default tiling mode
workspace_layout default

# Use Mouse+$mod to drag floating windows
floating_modifier $mod

#################################
#       WORKSPACE NAMES         #
#################################
set $ws1 "1:"
set $ws2 "2:"
set $ws3 "3:󰭣"
set $ws4 "4:"
set $ws5 "5:"
set $ws6 "6:󰏉"
set $ws7 "7:󰏓"
set $ws8 "8:󰺟"
set $ws9 "9:󱤓"
set $ws10 "10:"
set $ws11 "11:"
set $ws12 "12:²"
set $ws13 "13: ²"
set $ws14 "14"
set $ws15 "15"
set $ws16 "16"
set $ws17 "17"
set $ws18 "18"
set $ws19 "19"
set $ws20 "20"

#################################
#      WORKSPACE NAVIGATION     #
#################################

# Switch/iterate between workspaces
bindsym $mod+Tab workspace next
bindsym $mod+Shift+Tab workspace prev

# Mouse wheel workspace switching
bindsym $mod+Button4 workspace prev
bindsym $mod+Button5 workspace next

# Switch to workspace (number row)
bindsym $mod+1 workspace $ws1
bindsym $mod+2 workspace $ws2
bindsym $mod+3 workspace $ws3
bindsym $mod+4 workspace $ws4
bindsym $mod+5 workspace $ws5
bindsym $mod+6 workspace $ws6
bindsym $mod+7 workspace $ws7
bindsym $mod+8 workspace $ws8
bindsym $mod+9 workspace $ws9
bindsym $mod+0 workspace $ws10
bindsym $mod+m workspace $ws11

# Switch to workspace (numpad without numlock)
bindcode $mod+87 workspace $ws1
bindcode $mod+88 workspace $ws2
bindcode $mod+89 workspace $ws3
bindcode $mod+83 workspace $ws4
bindcode $mod+84 workspace $ws5
bindcode $mod+85 workspace $ws6
bindcode $mod+79 workspace $ws7
bindcode $mod+80 workspace $ws8
bindcode $mod+81 workspace $ws9
bindcode $mod+90 workspace $ws10
bindcode $mod+77 workspace $ws11
bindcode $mod+78 workspace $ws12
bindcode $mod+74 workspace $ws13
bindcode $mod+75 workspace $ws14

# Switch to workspace (numpad with numlock)
bindcode $mod+Mod2+87 workspace $ws1
bindcode $mod+Mod2+88 workspace $ws2
bindcode $mod+Mod2+89 workspace $ws3
bindcode $mod+Mod2+83 workspace $ws4
bindcode $mod+Mod2+84 workspace $ws5
bindcode $mod+Mod2+85 workspace $ws6
bindcode $mod+Mod2+79 workspace $ws7
bindcode $mod+Mod2+80 workspace $ws8
bindcode $mod+Mod2+81 workspace $ws9
bindcode $mod+Mod2+90 workspace $ws10
bindcode $mod+Mod2+77 workspace $ws11
bindcode $mod+Mod2+78 workspace $ws12
bindcode $mod+Mod2+74 workspace $ws13
bindcode $mod+Mod2+75 workspace $ws14

#################################
#      MOVE TO WORKSPACE        #
#################################

# Move focused container to workspace (number row)
bindsym $mod+Shift+1 move container to workspace $ws1
bindsym $mod+Shift+2 move container to workspace $ws2
bindsym $mod+Shift+3 move container to workspace $ws3
bindsym $mod+Shift+4 move container to workspace $ws4
bindsym $mod+Shift+5 move container to workspace $ws5
bindsym $mod+Shift+6 move container to workspace $ws6
bindsym $mod+Shift+7 move container to workspace $ws7
bindsym $mod+Shift+8 move container to workspace $ws8
bindsym $mod+Shift+9 move container to workspace $ws9
bindsym $mod+Shift+0 move container to workspace $ws10
bindsym $mod+Shift+m move container to workspace $ws11

# Move focused container to workspace (numpad without numlock)
bindcode $mod+Shift+87 move container to workspace $ws1
bindcode $mod+Shift+88 move container to workspace $ws2
bindcode $mod+Shift+89 move container to workspace $ws3
bindcode $mod+Shift+83 move container to workspace $ws4
bindcode $mod+Shift+84 move container to workspace $ws5
bindcode $mod+Shift+85 move container to workspace $ws6
bindcode $mod+Shift+79 move container to workspace $ws7
bindcode $mod+Shift+80 move container to workspace $ws8
bindcode $mod+Shift+81 move container to workspace $ws9
bindcode $mod+Shift+90 move container to workspace $ws10
bindcode $mod+Shift+77 move container to workspace $ws11
bindcode $mod+Shift+78 move container to workspace $ws12
bindcode $mod+Shift+74 move container to workspace $ws13
bindcode $mod+Shift+75 move container to workspace $ws14

# Move focused container to workspace (numpad with numlock)
bindcode $mod+Shift+Mod2+87 move container to workspace $ws1
bindcode $mod+Shift+Mod2+88 move container to workspace $ws2
bindcode $mod+Shift+Mod2+89 move container to workspace $ws3
bindcode $mod+Shift+Mod2+83 move container to workspace $ws4
bindcode $mod+Shift+Mod2+84 move container to workspace $ws5
bindcode $mod+Shift+Mod2+85 move container to workspace $ws6
bindcode $mod+Shift+Mod2+79 move container to workspace $ws7
bindcode $mod+Shift+Mod2+80 move container to workspace $ws8
bindcode $mod+Shift+Mod2+81 move container to workspace $ws9
bindcode $mod+Shift+Mod2+90 move container to workspace $ws10
bindcode $mod+Shift+Mod2+77 move container to workspace $ws11
bindcode $mod+Shift+Mod2+78 move container to workspace $ws12
bindcode $mod+Shift+Mod2+74 move container to workspace $ws13
bindcode $mod+Shift+Mod2+75 move container to workspace $ws14

#################################
#           MODES               #
#################################

# Page 2 workspace mode
mode "Page 2" {
    bindsym $mod+1 workspace $ws11
    bindsym $mod+2 workspace $ws12
    bindsym $mod+3 workspace $ws13
    bindsym $mod+4 workspace $ws14
    bindsym $mod+5 workspace $ws15
    bindsym $mod+6 workspace $ws16
    bindsym $mod+7 workspace $ws17
    bindsym $mod+8 workspace $ws18
    bindsym $mod+9 workspace $ws19
    bindsym $mod+0 workspace $ws20

    bindsym $mod+Shift+1 move container to workspace $ws11
    bindsym $mod+Shift+2 move container to workspace $ws12
    bindsym $mod+Shift+3 move container to workspace $ws13
    bindsym $mod+Shift+4 move container to workspace $ws14
    bindsym $mod+Shift+5 move container to workspace $ws15
    bindsym $mod+Shift+6 move container to workspace $ws16
    bindsym $mod+Shift+7 move container to workspace $ws17
    bindsym $mod+Shift+8 move container to workspace $ws18
    bindsym $mod+Shift+9 move container to workspace $ws19
    bindsym $mod+Shift+0 move container to workspace $ws20

    bindsym Return mode "default"
    bindsym Escape mode "default"
}

bindsym $mod+e mode "Page 2"

# Resize window mode
mode "resize" {
    bindsym Left resize shrink width 10 px or 10 ppt
    bindsym Down resize grow height 10 px or 10 ppt
    bindsym Up resize shrink height 10 px or 10 ppt
    bindsym Right resize grow width 10 px or 10 ppt

    bindsym Return mode "default"
    bindsym Escape mode "default"
}

bindsym $mod+r mode "resize"

#################################
#        KEY BINDINGS           #
#################################

# Application shortcuts
bindsym $mod+Return exec ghostty
bindsym $mod+w exec /usr/bin/zen-browser
bindsym $mod+q kill

# Screenshots
bindsym $mod+Shift+s exec flameshot gui

# System
bindsym $mod+l exec ~/.config/scripts/rofi-screenshot
bindsym $mod+Shift+e exec ~/.config/scripts/powermenu
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart

# Power Profiles menu
bindsym $mod+Shift+a exec ~/.config/scripts/asus-profile

# Display management
bindsym $mod+Shift+p exec /usr/bin/autorandr -c --force &
bindsym $mod+p move workspace to output next

#################################
#       FOCUS & MOVEMENT        #
#################################

# Change focus
bindsym $mod+j focus left
bindsym $mod+k focus down
bindsym $mod+b focus up
bindsym $mod+o focus right

# Arrow keys alternative
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Move focussed window
bindsym $mod+Shift+j move left
bindsym $mod+Shift+k move down
bindsym $mod+Shift+b move up
bindsym $mod+Shift+o move right

# Arrow keys alternative
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

#################################
#          LAYOUT               #
#################################

# Split containers
bindsym $mod+h split h
bindsym $mod+v split v

# Fullscreen
bindsym $mod+f fullscreen toggle

# Container layout
bindsym $mod+s layout stacking
bindsym $mod+g layout tabbed
bindsym $mod+d layout toggle split

# Toggle tiling/floating
bindsym $mod+Shift+Mod1 floating toggle

# Change focus between tiling/floating windows
bindsym $mod+Mod1 focus mode_toggle

# Focus parent container
bindsym $mod+a focus parent

#################################
#      MULTIMEDIA KEYS          #
#################################

# Volume
bindsym XF86AudioRaiseVolume exec --no-startup-id ~/.config/scripts/volume --up
bindsym XF86AudioLowerVolume exec --no-startup-id ~/.config/scripts/volume --down
bindsym XF86AudioMute exec --no-startup-id ~/.config/scripts/volume --mute

# Microphone
bindsym XF86AudioMicMute exec amixer sset Capture toggle

# Media control
bindsym XF86AudioPlay exec playerctl play
bindsym XF86AudioPause exec playerctl pause
bindsym XF86AudioNext exec playerctl next
bindsym XF86AudioPrev exec playerctl previous

# Brightness
bindsym XF86MonBrightnessUp exec --no-startup-id ~/.config/scripts/volume --bright-up
bindsym XF86MonBrightnessDown exec --no-startup-id ~/.config/scripts/volume --bright-down

#################################
#          ROFI MENUS           #
#################################

# Application launcher
# bindsym $mod+space exec rofi -show combi -config ~/.config/rofi/rofidmenu.rasi
bindsym $mod+space exec vicinae toggle
# Window switcher
bindsym $mod+t exec rofi -show window -config ~/.config/rofi/rofidmenu.rasi

#################################
#      WINDOW ASSIGNMENTS       #
#################################

# Assign programs to workspaces
assign [class="ghostty" title="^(?!.*Popup-terminal)"] $ws1
assign [class="(?i)firefox"] $ws2
assign [class="(?i)zen"] $ws2
assign [class="datagrip"] $ws4
assign [class="Thunar"] $ws5
assign [class="xviix64.exe"] $ws6
assign [class="CoppeliaSim"] $ws6
assign [class="MATLAB(?i)" title="^(?!Figure [0-9]+).*"] $ws6
assign [class="LibrePCB" title="Control Panel - LibrePCB 1\.1\.0"] $ws7
assign [class="kicad" title="(?i) — KiCad (?i)"] $ws7
assign [class="LibrePCB" title="(?i) - LibrePCB Schematic Editor"] $ws8
assign [title="LTspice"] $ws8
assign [class="kicad" title="(?i) - Schematic Editor"] $ws8
assign [class="LibrePCB" title="(?i) - LibrePCB Board Editor"] $ws9
assign [class="cider"] $ws10
assign [class="vesktop"] $ws11
assign [class="zoom"] $ws11
assign [class="Microsoft Teams - Preview"] $ws11

#################################
#        WINDOW RULES           #
#################################

# Focus new windows
for_window [class=ghostty] focus
for_window [class=(?i)zen] focus; layout tabbed
for_window [class=Thunar] focus
for_window [class=vesktop] focus; layout tabbed
for_window [class=zoom] focus; layout tabbed
for_window [class=LibrePCB] focus
for_window [class=cider] focus
for_window [title="LTspice"] focus
for_window [class=MATLAB(?i) title="^(?!Figure [0-9]+).*"] focus; layout tabbed

# Special window behaviour
for_window [title="Picture-in-Picture"] floating enable, sticky enable
for_window [class=schulrechner] floating enable, sticky enable
for_window [title="(?i)Popup-terminal"] floating enable, sticky enable, move position 1120 px 35 px
for_window [class=MATLAB(?i) title="Figure [0-9]+"] floating enable, focus no, border pixel 20
for_window [class=calligraphy] floating enable
for_window [class=binary] floating enable

# Floating windows
for_window [class="Yad" instance="yad"] floating enable
for_window [class="Galculator" instance="galculator"] floating enable
for_window [class="Blueberry.py" instance="blueberry.py"] floating enable
for_window [class="Xsane" instance="xsane"] floating enable
for_window [class="Pavucontrol" instance="pavucontrol"] floating enable
for_window [class="qt5ct" instance="qt5ct"] floating enable
for_window [class="Bluetooth-sendto" instance="bluetooth-sendto"] floating enable
for_window [class="Pamac-manager"] floating enable
for_window [window_role="About"] floating enable

# Window borders
for_window [class="urxvt"] border pixel 1

#################################
#           COLOURS             #
#################################

# Colour variables
set $bg0         #2d353b
set $bg1         #343f44
set $bg2         #3d484d
set $bg3         #475258
set $bg4         #4f585e
set $bg5         #56635f
set $grey0       #7a8478
set $grey1       #859289
set $grey2       #9da9a0
set $fg          #d3c6aa
set $red         #e67e80
set $orange      #e69875
set $yellow      #dbbc7f
set $green       #a7c080
set $aqua        #83c092
set $blue        #7fbbb3
set $purple      #d699b6
set $statusline1 #a7c080
set $statusline2 #d3c6aa
set $statusline3 #e67e80

# Window colours (Everforest theme)
